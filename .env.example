# Hosted service
RED_WOLF_SERVICE_TOKEN=replace-with-a-long-random-token
# Or provide multiple isolated tenant tokens (comma-separated):
# RED_WOLF_SERVICE_TOKENS=tenant-a-token,tenant-b-token
RED_WOLF_ALLOWED_HOSTS=target.example.com
RED_WOLF_SERVICE_DB=/var/lib/red-wolf/service.db
RED_WOLF_WORKERS=2
RED_WOLF_MAX_JOBS_PER_WINDOW=5
RED_WOLF_JOB_WINDOW_SECONDS=3600

# Local CLI learning database
# RED_WOLF_LEARNING_DB=~/.red_wolf/learning.db

# Optional CLI AI integration
# RED_WOLF_AI_PROVIDER=openai
# RED_WOLF_AI_API_KEY=
# RED_WOLF_AI_MODEL=
# RED_WOLF_AI_BASE_URL=
